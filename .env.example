# ==============================================================================
# AI SOCIAL MEDIA AGENT - PRINTING INDUSTRY (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM CONFIGURATION (Pilih salah satu: GEMINI atau OPENAI)
# ------------------------------------------------------------------------------
LLM_PROVIDER=gemini
# LLM_PROVIDER=openai

# Google Gemini API
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API (Alternatif jika menggunakan OpenAI)
OPENAI_API_KEY=sk-proj-YourOpenAiApiKeyHere
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 2. BRAND & TEMPLATE IDENTITY
# ------------------------------------------------------------------------------
BRAND_NAME=PRINTFORGE STUDIO
BRAND_TAGLINE=Pusat Edukasi & Solusi Cetak Profesional
BRAND_HANDLE=@printforge.id

# ------------------------------------------------------------------------------
# 3. CLOUD STORAGE CONFIGURATION
# ------------------------------------------------------------------------------
# Provider: 'cloudinary' (Disarankan: cepat, direct secure HTTPS) atau 's3'
STORAGE_PROVIDER=cloudinary

# Cloudinary Credentials (Dapatkan gratis di https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AWS S3 (Alternatif jika menggunakan AWS S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION=ap-southeast-1

# ------------------------------------------------------------------------------
# 4. INSTAGRAM META GRAPH API CONFIGURATION
# ------------------------------------------------------------------------------
# Meta Graph API Version (Gunakan v19.0 atau versi terbaru)
GRAPH_API_VERSION=v19.0

# Instagram Business/Creator Account ID (Numeric ID, BUKAN username)
# Contoh: 17841400012345678
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id

# Meta Long-Lived User Access Token atau System User Token (Never Expiring)
INSTAGRAM_ACCESS_TOKEN=EAAG...YourLongLivedOrSystemUserAccessToken

# ------------------------------------------------------------------------------
# 5. SCHEDULER SETTINGS (APScheduler / Cron)
# ------------------------------------------------------------------------------
# Waktu posting harian (Format 24 jam)
SCHEDULE_HOUR=09
SCHEDULE_MINUTE=00
TIMEZONE=Asia/Jakarta

# ------------------------------------------------------------------------------
# 6. SECOND ACCOUNT: CULTIVARE COLLECTIVE (@cultivaree_)
# ------------------------------------------------------------------------------
CULTIVARE_BRAND_NAME=Cultivare Collective
CULTIVARE_BRAND_HANDLE=@cultivaree_
CULTIVARE_BRAND_TAGLINE=Strategic Brand Development & Global Economy Culture
CULTIVARE_INSTAGRAM_ACCOUNT_ID=your_cultivare_instagram_account_id
CULTIVARE_INSTAGRAM_ACCESS_TOKEN=your_cultivare_meta_page_access_token
CULTIVARE_SCHEDULE_HOUR=18
CULTIVARE_SCHEDULE_MINUTE=30

